NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. From Supabase Dashboard -> Project Settings -> API -> service_role key.
# NEVER prefix with NEXT_PUBLIC_ and never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# One-time protection for /admin/setup. Generate with: openssl rand -hex 32
# Keep server-only; never use a NEXT_PUBLIC_ prefix.
SUPER_ADMIN_SETUP_KEY=replace_me

# WhatsApp Notifications module -----------------------------------------------------------------

# Encrypts the WhatsApp access token at rest in the database (see lib/whatsapp/crypto.ts). The
# token itself is entered on /settings/whatsapp, not here. Generate with: openssl rand -hex 32
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=replace_me

# Authenticates Vercel Cron's daily calls to /api/cron/whatsapp-reminders — Vercel adds the
# `Authorization: Bearer $CRON_SECRET` header to cron requests automatically once this is set.
CRON_SECRET=replace_me

# A static string you choose; enter the same value again when configuring the webhook URL in
# Meta Business Manager (used only for the GET verification handshake).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_me

# Optional. Used to build the public receipt link sent over WhatsApp; falls back to Vercel's own
# deployment URL, then http://localhost:3000, if unset.
NEXT_PUBLIC_SITE_URL=

# hCaptcha site key (public) for the admin/member login and forgot-password forms
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=replace_me
